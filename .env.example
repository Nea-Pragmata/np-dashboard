# App (client, SvelteKit $env/static/public — must be PUBLIC_-prefixed)
PUBLIC_PB_URL=http://127.0.0.1:8090
# PostHog project API key (eu.posthog.com project 90784 → Settings). Safe to expose.
PUBLIC_POSTHOG_KEY=phc_REPLACE_ME

# Type generation (bun run typegen — reads these, never bundled into the app)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me
